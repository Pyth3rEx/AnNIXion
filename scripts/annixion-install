#!/usr/bin/env bash
#
# annixion-install — guided installer, bundled into the live ISO.
# Partitions and formats a disk, clones the config to ~/.dotfiles and runs
# nixos-install. See docs/installation.md.

set -euo pipefail

# ── Colours ────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}${BOLD}==> ${RESET}${BOLD}$*${RESET}"; }
success() { echo -e "${GREEN}${BOLD} ✓  $*${RESET}"; }
warn()    { echo -e "${YELLOW}${BOLD}[!] $*${RESET}"; }
die()     { echo -e "${RED}${BOLD}[✗] $*${RESET}" >&2; exit 1; }

# ── Help ────────────────────────────────────────────────────────────────────
# Handled before the sudo re-exec, so --help never needs root.
case "${1:-}" in
  -h | --help)
    cat <<'USAGE'
usage: annixion-install

Installs AnNIXion to disk from the live ISO: partitions, formats, mounts
and runs nixos-install. Re-execs itself through sudo.

  -h, --help  show this help
USAGE
    exit 0
    ;;
esac

# ── Elevate to root ─────────────────────────────────────────────────────────
# The live ISO grants operator passwordless sudo for this script.
if [[ ${EUID} -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

# ── Banner ─────────────────────────────────────────────────────────────────
clear
echo -e "${RED}${BOLD}"
cat << 'EOF'
 █████╗ ███╗   ██╗███╗  ██╗██╗██╗  ██╗██╗ ██████╗ ███╗ ██╗
██╔══██╗████╗  ██║████╗ ██║██║╚██╗██╔╝██║██╔═══██╗████╗██║
███████║██╔██╗ ██║██╔██╗██║██║ ╚███╔╝ ██║██║   ██║██╔████║
██╔══██║██║╚██╗██║██║╚████║██║ ██╔██╗ ██║██║   ██║██║╚███║
██║  ██║██║ ╚████║██║ ╚███║██║██╔╝╚██╗██║╚██████╔╝██║ ╚██║
╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚══╝╚═╝╚═╝  ╚═╝╚═╝ ╚═════╝ ╚═╝  ╚═╝
                                        I N S T A L L E R
EOF
echo -e "${RESET}"
echo -e "  This script will install ${BOLD}AnNIXion${RESET} onto your machine."
echo -e "  ${YELLOW}All data on the chosen disk will be permanently erased.${RESET}\n"

# ── Disk selection ─────────────────────────────────────────────────────────
info "Available disks"
lsblk -d -o NAME,SIZE,MODEL --noheadings | grep -Ev "loop|sr[0-9]"
echo

read -rp "  Disk to install on (e.g. sda, nvme0n1): " DISK_NAME
DISK="/dev/${DISK_NAME}"
[[ -b "$DISK" ]] || die "$DISK is not a block device."

DISK_SIZE=$(lsblk -dno SIZE "$DISK")
echo
warn "ALL DATA ON $DISK ($DISK_SIZE) WILL BE ERASED."
read -rp "  Type 'yes' to confirm: " CONFIRM
[[ "$CONFIRM" == "yes" ]] || { echo "Aborted."; exit 0; }

# ── Partition ──────────────────────────────────────────────────────────────
info "Partitioning $DISK"
parted --script "$DISK" \
  mklabel gpt \
  mkpart ESP fat32 1MiB 512MiB \
  set 1 esp on \
  mkpart primary 512MiB 100%
success "Partitioned"

# Derive partition names (nvme0n1 → nvme0n1p1, sda → sda1)
if [[ "$DISK" == *nvme* || "$DISK" == *mmcblk* ]]; then
  PART_BOOT="${DISK}p1"
  PART_ROOT="${DISK}p2"
else
  PART_BOOT="${DISK}1"
  PART_ROOT="${DISK}2"
fi

# ── Format ─────────────────────────────────────────────────────────────────
info "Formatting partitions"
mkfs.fat -F 32 -n boot "$PART_BOOT"
mkfs.ext4 -L nixos "$PART_ROOT"
# Let udev create the /dev/disk/by-label/* symlinks before we rely on them.
udevadm settle
success "Formatted"

# ── Mount ──────────────────────────────────────────────────────────────────
# By device node, not by-label: udev populates those symlinks asynchronously
# after mkfs, and racing it yields "Can't lookup blockdev".
info "Mounting"
mount "$PART_ROOT" /mnt
mkdir -p /mnt/boot
mount "$PART_BOOT" /mnt/boot
success "Mounted at /mnt"

# ── Fetch AnNIXion config ──────────────────────────────────────────────────
# ~/.dotfiles is its canonical location, not /etc/nixos: the Home Manager
# modules and shell aliases reference that path, and cloning anywhere else
# leaves the wallpaper, icons and certs dangling.
DOTFILES="/mnt/home/operator/.dotfiles"
info "Cloning AnNIXion configuration"
mkdir -p /mnt/home/operator
git clone https://github.com/Pyth3rEx/AnNIXion "$DOTFILES"
success "Cloned to /home/operator/.dotfiles"

# ── Hardware config ────────────────────────────────────────────────────────
info "Detecting hardware"
nixos-generate-config --root /mnt --dir "$DOTFILES"
# The flake owns system config; drop the generated configuration.nix.
rm -f "$DOTFILES/configuration.nix"
# Flakes ignore untracked files, and this one is gitignored. Staging is
# enough — Nix reads the index without needing a commit.
git -C "$DOTFILES" add -f hardware-configuration.nix
success "hardware-configuration.nix written and staged"

# ── Install ────────────────────────────────────────────────────────────────
info "Installing AnNIXion — this will take a while"
echo -e "  ${YELLOW}Tip: security tools are large. Expect 30–60 min on a slow connection.${RESET}\n"
nixos-install --root /mnt --flake "$DOTFILES#AnNIXion" --no-root-password

# ── Ownership ───────────────────────────────────────────────────────────────
# Cloned as root. Resolve uid/gid inside the installed system so the result
# holds whatever ids it allocated.
info "Fixing ownership of /home/operator"
nixos-enter --root /mnt -c 'chown -R operator:users /home/operator'
success "Ownership set"

# ── Done ───────────────────────────────────────────────────────────────────
echo
success "Installation complete!"
echo -e "\n  ${BOLD}Login:${RESET}  operator  /  (password set in your configuration)"
echo -e "  ${BOLD}Next:${RESET}   reboot, remove the USB, and boot from disk.\n"
read -rp "  Reboot now? [y/N] " REBOOT
[[ "${REBOOT,,}" == "y" ]] && reboot
