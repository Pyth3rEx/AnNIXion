#!/usr/bin/env bash
#
# annixion-install — guided installer, bundled into the live ISO.
# Collects a config (wizard or --user-config), partitions and formats a
# disk, clones the config to ~/.dotfiles and runs nixos-install. See
# docs/installation.md.

set -euo pipefail

# ── Colours ────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}${BOLD}==> ${RESET}${BOLD}$*${RESET}"; }
success() { echo -e "${GREEN}${BOLD} ✓  $*${RESET}"; }
warn()    { echo -e "${YELLOW}${BOLD}[!] $*${RESET}"; }
die()     { echo -e "${RED}${BOLD}[✗] $*${RESET}" >&2; exit 1; }

# Takes over the whole terminal instead of scrolling text in the login
# shell behind it — entered once the banner is about to print, below.
# On a failure inside the alt screen, the error would otherwise vanish the
# instant rmcup switches back; pause so it stays readable first.
ALTSCREEN=0
# Set only around the install step's banner (below) — a scroll region or
# background animation left dangling past this script's exit, from a
# crash or Ctrl-C rather than the normal path that already cleans both up
# inline, would leave the next shell looking broken the same way nmtui did
# before that got fixed. Cleaned up here unconditionally, same reasoning
# as ALTSCREEN/rmcup above.
SCROLL_REGION_SET=0
ANIM_PID=""
_leave_altscreen() {
  local status=$?
  [[ -n "$ANIM_PID" ]] && kill "$ANIM_PID" 2>/dev/null
  if [[ "$SCROLL_REGION_SET" == 1 ]]; then
    tput csr 0 "$(($(tput lines 2>/dev/null || echo 24) - 1))" 2>/dev/null || true
  fi
  if [[ "$ALTSCREEN" == 1 ]]; then
    if [[ $status -ne 0 ]]; then
      echo
      read -rp "  Press Enter to return to the shell... " _ || true
    fi
    tput rmcup 2>/dev/null || true
  fi
  exit "$status"
}
trap _leave_altscreen EXIT

# installer/validate.sh and installer/wizard.sh sit beside this script's own
# store path (iso/default.nix), whether run from the ISO or (for --help)
# straight out of a checkout.
INSTALLER_LIBEXEC="$(cd "$(dirname "${BASH_SOURCE[0]}")/../libexec/annixion-installer" 2>/dev/null && pwd || true)"
if [[ -z "$INSTALLER_LIBEXEC" ]]; then
  INSTALLER_LIBEXEC="$(cd "$(dirname "${BASH_SOURCE[0]}")/installer" 2>/dev/null && pwd || true)"
fi
[[ -n "$INSTALLER_LIBEXEC" ]] || die "cannot find installer/validate.sh and installer/wizard.sh."
# shellcheck source=scripts/installer/validate.sh disable=SC1091
source "$INSTALLER_LIBEXEC/validate.sh"
# shellcheck source=scripts/installer/wizard.sh disable=SC1091
source "$INSTALLER_LIBEXEC/wizard.sh"

# ── Arguments ────────────────────────────────────────────────────────────────
# Handled before the sudo re-exec, so --help never needs root.
ORIG_ARGS=("$@")
USER_CONFIG=""
BRANCH=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      cat <<'USAGE'
usage: annixion-install [--user-config <path|git-url>] [--branch <name>]

Installs AnNIXion to disk from the live ISO: collects a config (wizard, or
imported with --user-config), partitions, formats, mounts and runs
nixos-install. Re-execs itself through sudo.

  --user-config <path|git-url>  import an existing user/ folder and skip
                                 whatever prompts it already answers
  --branch <name>               clone this branch instead of asking
  -h, --help                    show this help
USAGE
      exit 0
      ;;
    --user-config)
      [[ $# -ge 2 ]] || die "--user-config needs a path or git URL."
      USER_CONFIG="$2"
      shift 2
      ;;
    --branch)
      [[ $# -ge 2 ]] || die "--branch needs a name."
      BRANCH="$2"
      shift 2
      ;;
    *)
      die "unknown argument: $1 (see --help)"
      ;;
  esac
done

# ── Test hooks ───────────────────────────────────────────────────────────────
# Every ANNIXION_TEST_* variable is tests/repo/installer.sh's own seam into a
# script that otherwise assumes a real disk and a real root re-exec. None of
# them are set, or meant to be set, outside that test.
MNT="${ANNIXION_TEST_MNT:-/mnt}"

# ── UEFI guard ───────────────────────────────────────────────────────────────
# Checked before any disk is touched: a CSM/legacy boot succeeds all the way
# through nixos-install and only fails at the boot loader, disk already wiped.
[[ -d "${ANNIXION_TEST_EFI_DIR:-/sys/firmware/efi}" ]] || die "booted in legacy BIOS/CSM mode — AnNIXion is UEFI-only. See docs/installation.md."

# ── Elevate to root ─────────────────────────────────────────────────────────
# The live ISO grants operator passwordless sudo for this script.
if [[ ${EUID} -ne 0 && -z "${ANNIXION_TEST_SKIP_SUDO:-}" ]]; then
  exec sudo "$0" "${ORIG_ARGS[@]}"
fi

# ── Banner ─────────────────────────────────────────────────────────────────
tput smcup 2>/dev/null && ALTSCREEN=1
clear 2>/dev/null || true
BANNER_ART=$(
  cat <<'EOF'
 █████╗ ███╗   ██╗███╗  ██╗██╗██╗  ██╗██╗ ██████╗ ███╗ ██╗
██╔══██╗████╗  ██║████╗ ██║██║╚██╗██╔╝██║██╔═══██╗████╗██║
███████║██╔██╗ ██║██╔██╗██║██║ ╚███╔╝ ██║██║   ██║██╔████║
██╔══██║██║╚██╗██║██║╚████║██║ ██╔██╗ ██║██║   ██║██║╚███║
██║  ██║██║ ╚████║██║ ╚███║██║██╔╝╚██╗██║╚██████╔╝██║ ╚██║
╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚══╝╚═╝╚═╝  ╚═╝╚═╝ ╚═════╝ ╚═╝  ╚═╝
                                        I N S T A L L E R
EOF
)
gum style --foreground 196 --bold --border double --padding "1 4" --align center "$BANNER_ART" "" \
  "This will install AnNIXion onto this machine." \
  "All data on the chosen disk will be permanently erased." "" \
  "No network yet? Ctrl-C, run nmtui, then annixion-install again."
echo

# ── Fetch AnNIXion, and resolve the config, before any disk is touched ─────
# A scratch clone, not /mnt/home/<user>/.dotfiles yet — there is no disk
# to hold it until after partitioning. Moved into place once there is one.
[[ -n "$BRANCH" ]] || BRANCH=$(gum input --header "Branch to install" --placeholder "blank for the repo's default branch")
CLONE_ARGS=()
[[ -n "$BRANCH" ]] && CLONE_ARGS+=(--branch "$BRANCH")

STAGE=$(mktemp -d)
gum spin --show-error --title "Fetching AnNIXion configuration" -- \
  git clone "${CLONE_ARGS[@]}" "${ANNIXION_TEST_REPO_URL:-https://github.com/Pyth3rEx/AnNIXion}" "$STAGE"
success "Cloned"

CANDIDATE=""
if [[ -n "$USER_CONFIG" ]]; then
  case "$USER_CONFIG" in
    http://* | https://* | git@* | ssh://*)
      warn "Importing a config from a URL runs arbitrary Nix as root during install."
      CANDIDATE=$(mktemp -d)
      git clone --depth 1 "$USER_CONFIG" "$CANDIDATE"
      ;;
    *)
      [[ -d "$USER_CONFIG" ]] || die "$USER_CONFIG is not a directory."
      CANDIDATE="$USER_CONFIG"
      ;;
  esac
fi

if [[ -n "$CANDIDATE" ]]; then
  info "Validating the provided config"
  while true; do
    status=$(validate_config "$CANDIDATE" "$STAGE")
    [[ "$status" == "ok" ]] && break
    warn "That config does not evaluate: ${status#broken: }"
    choice=$(gum choose "Edit it" "Continue without it" "Abort")
    case "$choice" in
      "Edit it") "${EDITOR:-vi}" "$CANDIDATE/user/configuration.nix" ;;
      "Continue without it")
        CANDIDATE=""
        break
        ;;
      *) die "Aborted." ;;
    esac
  done
  [[ -n "$CANDIDATE" ]] && success "Config evaluates"
fi

CURRENT_VERSION=$(tr -d '[:space:]' <"$STAGE/VERSION")
RUN_WIZARD="true"
WIZARD_DEFAULTS=""
if [[ -n "$CANDIDATE" ]]; then
  read -r cand_version cand_skip <<<"$(read_config_stamp "$CANDIDATE")"
  if [[ -n "$cand_version" ]] && version_ge "$cand_version" "$MIN_CONFIG_VERSION" && [[ "$cand_skip" == "skip" ]]; then
    RUN_WIZARD="false"
  else
    WIZARD_DEFAULTS=$(extract_defaults "$STAGE")
  fi
fi

if [[ "$RUN_WIZARD" == "true" ]]; then
  run_wizard "$WIZARD_DEFAULTS"
  write_user_folder "$STAGE" "$CURRENT_VERSION"
  INSTALL_USERNAME="$WIZ_USERNAME"
else
  info "Reusing the provided config — skipping the wizard"
  # The wizard never ran, so there's no $WIZ_USERNAME to read — ask the
  # staged config itself what users.users.operator.name actually resolves
  # to, the same way its other options get read back.
  INSTALL_USERNAME=$(read_username "$STAGE")
fi

# ── Disk selection ─────────────────────────────────────────────────────────
# Interactive in every case — it describes the machine in front of you, not
# a stored preference.
info "Available disks"
gum style --foreground 15 --border rounded --padding "0 1" \
  "$(lsblk -d -o NAME,SIZE,MODEL --noheadings | grep -Ev "loop|sr[0-9]")"
echo

read -rp "  Disk to install on (e.g. sda, nvme0n1): " DISK_NAME
DISK="/dev/${DISK_NAME}"
[[ -b "$DISK" || -n "${ANNIXION_TEST_SKIP_DISK_CHECK:-}" ]] || die "$DISK is not a block device."

DISK_SIZE=$(lsblk -dno SIZE "$DISK")
echo
warn "ALL DATA ON $DISK ($DISK_SIZE) WILL BE ERASED."
read -rp "  Type 'yes' to confirm: " CONFIRM
[[ "$CONFIRM" == "yes" ]] || { echo "Aborted."; exit 0; }

# ── Encryption ───────────────────────────────────────────────────────────
# A per-disk decision, not a stored preference — same reasoning as disk
# selection itself, so this is never skipped by --user-config and never
# written into user/configuration.nix.
ENCRYPT_DISK="false"
if gum confirm --default=true "Encrypt $DISK with LUKS2? (strongly recommended)"; then
  ENCRYPT_DISK="true"
fi

LUKS_PASSPHRASE=""
if [[ "$ENCRYPT_DISK" == "true" ]]; then
  while true; do
    lp1=$(gum input --password --header "LUKS passphrase")
    lp2=$(gum input --password --header "Again, to confirm")
    if [[ -z "$lp1" ]]; then
      gum style --foreground 196 "An empty passphrase is not one."
      continue
    fi
    [[ "$lp1" == "$lp2" ]] && break
    gum style --foreground 196 "Those did not match — try again."
  done
  LUKS_PASSPHRASE="$lp1"
  lp1=""
  lp2=""
fi

# Derive partition names (nvme0n1 → nvme0n1p1, sda → sda1)
if [[ "$DISK" == *nvme* || "$DISK" == *mmcblk* ]]; then
  PART_BOOT="${DISK}p1"
  PART_ROOT="${DISK}p2"
else
  PART_BOOT="${DISK}1"
  PART_ROOT="${DISK}2"
fi

# ── Clean slate ──────────────────────────────────────────────────────────
# A previous attempt on this disk — or a reused $MNT from one earlier this
# boot — can leave partitions mounted, swap active, or a filesystem/RAID/LVM
# signature behind that both parted and mke2fs treat as "are you sure?"
# territory. mke2fs's version of that prompt is invisible under gum spin's
# hidden output and just hangs forever waiting for an answer nobody can
# see to give. None of that should matter here: unconditionally tear it
# all down before the disk is touched for real.
info "Clearing any previous attempt on this disk"
swapoff "$PART_ROOT" "$PART_BOOT" 2>/dev/null || true
umount -R "$MNT" 2>/dev/null || true
umount "$PART_ROOT" "$PART_BOOT" 2>/dev/null || true
cryptsetup close cryptroot 2>/dev/null || true
wipefs -af "$DISK" "$PART_BOOT" "$PART_ROOT" 2>/dev/null || true
success "Disk is clear"

# ── Partition ──────────────────────────────────────────────────────────────
gum spin --show-error --title "Partitioning $DISK" -- \
  parted --script "$DISK" \
  mklabel gpt \
  mkpart ESP fat32 1MiB 512MiB \
  set 1 esp on \
  mkpart primary 512MiB 100%
success "Partitioned"

# ── Format ─────────────────────────────────────────────────────────────────
gum spin --show-error --title "Formatting partitions" -- env \
  ANNIXION_LUKS_PASSPHRASE="$LUKS_PASSPHRASE" bash -c '
  set -e
  mkfs.fat -F 32 -n BOOT "$1"
  # -F: format even though mke2fs thinks the partition already holds a
  # filesystem — true every retry on this same disk, and otherwise its
  # "proceed anyway?" prompt hangs invisibly under gum spin forever.
  if [[ "$2" == "true" ]]; then
    # Cipher and KDF cost are pinned explicitly, not left to cryptsetup auto
    # benchmarking against the install machine CPU/RAM to hit a ~2s default
    # — the same passphrase would otherwise end up weaker on a slow VM than
    # on a fast laptop. aes-xts-plain64/512 is the LUKS2 default cipher
    # (AES-256-XTS); argon2id at a ~10-15s, 2 GiB ceiling is a deliberately
    # harder target than that ~2s default. No --allow-discards: TRIM would
    # leak block-usage patterns to the underlying SSD controller.
    printf "%s" "$ANNIXION_LUKS_PASSPHRASE" | cryptsetup --batch-mode luksFormat --type luks2 \
      --cipher aes-xts-plain64 --key-size 512 \
      --pbkdf argon2id --pbkdf-memory 2097152 --pbkdf-parallel 4 --iter-time 12000 \
      "$3" --key-file -
    printf "%s" "$ANNIXION_LUKS_PASSPHRASE" | cryptsetup open "$3" cryptroot --key-file -
    mkfs.ext4 -F -L nixos /dev/mapper/cryptroot
  else
    mkfs.ext4 -F -L nixos "$3"
  fi
  # Let udev create the /dev/disk/by-label/* symlinks before we rely on them.
  udevadm settle
' -- "$PART_BOOT" "$ENCRYPT_DISK" "$PART_ROOT"
LUKS_PASSPHRASE=""
success "Formatted"

# ── Mount ──────────────────────────────────────────────────────────────────
# By device node, not by-label: udev populates those symlinks asynchronously
# after mkfs, and racing it yields "Can't lookup blockdev".
ROOT_DEV="$PART_ROOT"
[[ "$ENCRYPT_DISK" == "true" ]] && ROOT_DEV="/dev/mapper/cryptroot"
gum spin --show-error --title "Mounting" -- bash -c '
  set -e
  mount "$1" "$2"
  mkdir -p "$2/boot"
  mount "$3" "$2/boot"
' -- "$ROOT_DEV" "$MNT" "$PART_BOOT"
success "Mounted at $MNT"

# ── Move the resolved config into place ─────────────────────────────────────
# ~/.dotfiles is its canonical location, not /etc/nixos: the Home Manager
# modules and shell aliases reference that path, and cloning anywhere else
# leaves the wallpaper, icons and certs dangling. Moved rather than cloned
# again — $STAGE already holds the config, validated above.
DOTFILES="$MNT/home/$INSTALL_USERNAME/.dotfiles"
mkdir -p "$MNT/home/$INSTALL_USERNAME"
mv "$STAGE" "$DOTFILES"
success "Configuration in place at /home/$INSTALL_USERNAME/.dotfiles"

# ── Hardware config ────────────────────────────────────────────────────────
gum spin --show-error --title "Detecting hardware" -- \
  nixos-generate-config --root "$MNT" --dir "$DOTFILES"
# The flake owns system config; drop the generated configuration.nix.
rm -f "$DOTFILES/configuration.nix"
# Flakes ignore untracked files, and this one is gitignored. Staging is
# enough — Nix reads the index without needing a commit.
git -C "$DOTFILES" add -f hardware-configuration.nix
success "hardware-configuration.nix written and staged"

# Never let an install that was supposed to be encrypted boot up silently
# unencrypted: nixos-generate-config detects a mounted LUKS container on
# its own and writes boot.initrd.luks.devices for it, but if that detection
# ever fails, the install would otherwise succeed with an initrd that never
# asks for a passphrase.
if [[ "$ENCRYPT_DISK" == "true" ]]; then
  grep -q 'boot.initrd.luks.devices' "$DOTFILES/hardware-configuration.nix" ||
    die "nixos-generate-config did not detect the LUKS container — refusing to install a system whose initrd never asks for a passphrase. See docs/installation.md."
fi

# ── Install ────────────────────────────────────────────────────────────────
# Reserves the top of the screen for a bordered banner via a terminal
# scroll region (DECSTBM) — ordinary pre-TUI terminal control, nothing
# bubbletea-shaped to clash with. nix's own scrolling output, and whatever
# it pins to the terminal's real last row on its own, stay confined below
# this and behave exactly as they would on a full screen: DECSTBM only
# changes where line-feed scrolling happens, not what any given
# application thinks the screen size is.
#
# The reported freeze during an earlier version of this turned out to be
# unrelated (a config-schema mismatch surfacing after a slow-but-genuine
# nix evaluation, not this code) — but the three real bugs it shipped with
# are fixed here: clear first, so this doesn't draw over whatever was
# already on screen; a bordered box, so it doesn't run straight into the
# log below; and no elapsed-time counter. That counter and nix's own
# output were both writing to the same raw console, and nix's torrent of
# it can starve an occasional writer long enough that "elapsed" catches up
# in one visible leap — a plain spinner has no "current value" to be
# wrong about, so staleness there just looks like a normal animation.
warn "Security tools are large. Expect 30–60 min on a slow connection."
clear 2>/dev/null || true
TERM_LINES=$(tput lines 2>/dev/null || echo 24)
BANNER_ROWS=10

tput csr "$BANNER_ROWS" "$((TERM_LINES - 1))" 2>/dev/null && SCROLL_REGION_SET=1
tput cup 0 0 2>/dev/null || true
gum style --foreground 196 --bold --border double --padding "0 2" --align center "$BANNER_ART"
tput cup "$BANNER_ROWS" 0 2>/dev/null || true

(
  frames=('|' '/' '-' '\')
  i=0
  while true; do
    tput sc 2>/dev/null
    tput cup "$((BANNER_ROWS - 1))" 0 2>/dev/null
    tput el 2>/dev/null
    printf '%b  %s  Installing AnNIXion — this will take a while%b' \
      "${RED}${BOLD}" "${frames[i % 4]}" "${RESET}"
    tput rc 2>/dev/null
    i=$((i + 1))
    sleep 1
  done
) &
ANIM_PID=$!

if nixos-install --root "$MNT" --flake "$DOTFILES#AnNIXion" --no-root-password; then
  INSTALL_STATUS=0
else
  INSTALL_STATUS=$?
fi

kill "$ANIM_PID" 2>/dev/null || true
wait "$ANIM_PID" 2>/dev/null || true
ANIM_PID=""
# Resetting the scroll region is needed regardless of outcome, so it
# always runs — but clearing the actual screen content must not: nix's
# error is sitting right there in the log area on a failure, and clearing
# before the status check below wiped it out before the EXIT trap's own
# "press Enter" pause (which exists for exactly this reason) ever got a
# chance to show it.
tput csr 0 "$((TERM_LINES - 1))" 2>/dev/null || true
SCROLL_REGION_SET=0

[[ "$INSTALL_STATUS" -eq 0 ]] || exit "$INSTALL_STATUS"
clear 2>/dev/null || true
success "Installed"

# ── Ownership ───────────────────────────────────────────────────────────────
# Cloned as root. Resolve uid/gid inside the installed system so the result
# holds whatever ids it allocated. isNormalUser always puts everyone in the
# shared "users" group regardless of the account's own name, so only the
# owner half of this needs to track $INSTALL_USERNAME.
gum spin --show-error --title "Fixing ownership of /home/$INSTALL_USERNAME" -- \
  nixos-enter --root "$MNT" -c "chown -R $INSTALL_USERNAME:users /home/$INSTALL_USERNAME"
success "Ownership set"

# ── Done ───────────────────────────────────────────────────────────────────
echo
gum style --foreground 10 --bold --border double --padding "1 2" \
  "Installation complete!" "" \
  "Login:  $INSTALL_USERNAME  /  (password set in your configuration)" \
  "Next:   reboot, remove the USB, and boot from disk."
echo
read -rp "  Reboot now? [y/N] " REBOOT
if [[ "${REBOOT,,}" == "y" ]]; then
  reboot
fi
