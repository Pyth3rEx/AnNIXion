# Compatibility shims for renamed or removed `annixion.*` options.
#
# Adopted as policy before there is anything to rename: a `user/` folder
# generated by an older AnNIXion release is evaluated against the current
# release's option set (scripts/installer/validate.sh), so a rename here
# needs a shim here in the same change, or every older config starts failing
# to evaluate instead of migrating.
#
# Add one `lib.mkRenamedOptionModule [ "annixion" "old" ] [ "annixion" "new" ]`
# or `lib.mkRemovedOptionModule [ "annixion" "old" ] "<why, and what replaces it>"`
# per change. Bump scripts/installer/validate.sh's MIN_CONFIG_VERSION only when
# a removal here has no mechanical replacement — a rename alone does not need it.
{ ... }:

{
  imports = [
    # (none yet)
  ];
}
