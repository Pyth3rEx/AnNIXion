{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CI: L1 — Flake Check",
      "type": "shell",
      "command": "nix flake check --no-build",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CI: L2 — System Build",
      "type": "shell",
      "command": "nix build .#nixosConfigurations.AnNIXion-ci.config.system.build.toplevel --print-build-logs --no-link",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CI: L3 — VM Tests",
      "type": "shell",
      "command": "nix build .#checks.x86_64-linux.boot .#checks.x86_64-linux.security-tools --print-build-logs --no-link",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Lint: statix",
      "type": "shell",
      "command": "statix check .",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Lint: deadnix",
      "type": "shell",
      "command": "deadnix .",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Format: check",
      "type": "shell",
      "command": "nixfmt --check .",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Format: apply",
      "type": "shell",
      "command": "nixfmt .",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CI: Full (L1 + Lint)",
      "dependsOn": [
        "CI: L1 — Flake Check",
        "Lint: statix",
        "Lint: deadnix"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
