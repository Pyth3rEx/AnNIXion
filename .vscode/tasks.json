{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CI: L0 \u2014 Lint",
      "type": "shell",
      "command": "nix develop --command bash .github/scripts/lint.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CI: L1 \u2014 Flake Check",
      "type": "shell",
      "command": "nix flake check --no-build",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CI: L2 \u2014 System Build",
      "type": "shell",
      "command": "nix build .#nixosConfigurations.AnNIXion-ci.config.system.build.toplevel --print-build-logs --no-link",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CI: L3 \u2014 VM Tests",
      "type": "shell",
      "command": "nix build .#checks.x86_64-linux.boot .#checks.x86_64-linux.security-tools --print-build-logs --no-link",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Format: check",
      "type": "shell",
      "command": "nixfmt --check .",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Format: apply",
      "type": "shell",
      "command": "nixfmt .",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CI: Full (L0 + L1)",
      "dependsOn": [
        "CI: L0 \u2014 Lint",
        "CI: L1 \u2014 Flake Check"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
